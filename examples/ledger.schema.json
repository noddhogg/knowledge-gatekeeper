{
  "_readme": [
    "账本是整条管线的单一事实源。本文件同时给出结构定义与一个填充示例。",
    "硬约束：同一批次只允许一个进程写这个文件。并发写 JSON 会互相覆盖。",
    "quality_reason 写「剥掉包装后剩下的是什么」——标题与内容不一致只是核查提示，",
    "不是定档理由（SKILL.md 3.1 / CONTRIBUTING 均明令禁止，曾误写进本文件的示例，已修正）。",
    "fail_reason 只记技术失败（获取/转写/成页），定不入库的原因写 quality_reason。",
    "不变量：status=done 的条目必须已定档（quality 非空、且四档之一）并附 quality_reason。",
    "  「未经定档不得入库」是硬规则（SKILL.md 3.1），这里用 schema 的 if/then 强制，",
    "  免得它只是一条没人检查的散文约定。",
    "用法：把 example 节点复制为你的 $LEDGER 初始内容，schema 节点作为字段校验依据。"
  ],

  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["version", "items"],
    "properties": {
      "version": { "type": "string", "description": "结构版本号，结构变更时递增" },
      "updated_at": { "type": "string", "description": "最后写入时间，ISO 8601" },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "title", "status"],
          "properties": {
            "id": {
              "type": "string",
              "description": "素材唯一标识，整条管线的主键。注意区分短 id 与完整 id。"
            },
            "title": { "type": "string" },
            "source_url": { "type": "string" },
            "domain": {
              "type": "string",
              "description": "归属域，对应 $KB_ROOT 下的 <NN_域> 目录名"
            },
            "status": {
              "type": "string",
              "enum": ["pending", "working", "transcribed", "done", "failed"],
              "description": "pending 待获取 / working 获取或转写中 / transcribed 已转写待定档 / done 已入库或已判定不入 / failed 失败待重试"
            },
            "quality": {
              "type": "string",
              "enum": ["", "high", "medium", "low", "reject"],
              "description": "由 D 阶段质量门禁写入。空串表示尚未定档。"
            },
            "quality_reason": {
              "type": "string",
              "description": "定档理由，与 quality 同时写入。只写「剥掉包装后剩下的是什么」，不写包装本身——标题与内容不一致只是核查提示，不是定档理由（见 SKILL.md 3.1）。这条是门禁可审计、可回溯的唯一依据。"
            },
            "media": { "type": "string", "description": "媒体文件路径，相对 $KB_ROOT" },
            "transcript": { "type": "string", "description": "转写稿路径，相对 $KB_ROOT" },
            "page": { "type": "string", "description": "成页路径，相对 $KB_ROOT。low / reject 时留空。" },
            "fail_reason": {
              "type": "string",
              "description": "仅用于技术失败（获取/转写/成页失败），不是定档理由。定不入库的原因写 quality_reason，不要塞进这里。"
            },
            "retry_count": { "type": "integer", "minimum": 0 },
            "updated_at": { "type": "string" }
          },
          "allOf": [
            {
              "comment": "不变量：已入库（done）⇒ 必定已定档。四档门禁零例外，未经定档不得入库（SKILL.md 3.1）。",
              "if": {
                "properties": { "status": { "const": "done" } },
                "required": ["status"]
              },
              "then": {
                "required": ["quality", "quality_reason"],
                "properties": {
                  "quality": { "enum": ["high", "medium", "low", "reject"] },
                  "quality_reason": { "minLength": 1 }
                }
              }
            },
            {
              "comment": "技术失败（failed）必须写明失败原因，否则重试时无从判断该换什么路径。",
              "if": {
                "properties": { "status": { "const": "failed" } },
                "required": ["status"]
              },
              "then": {
                "required": ["fail_reason"],
                "properties": { "fail_reason": { "minLength": 1 } }
              }
            }
          ]
        }
      }
    }
  },

  "example": {
    "version": "1.2",
    "updated_at": "2026-08-30T15:40:00+08:00",
    "items": [
      {
        "id": "SRC-20260820-001",
        "title": "某个讲清楚的体系化教程",
        "source_url": "https://example.com/item/001",
        "domain": "01_示例域",
        "status": "done",
        "quality": "high",
        "quality_reason": "通读后能复述出 5 个具体可上手的操作步骤，且每一步都有论据；冗余占比低",
        "media": "_incoming/media/SRC-20260820-001.mp4",
        "transcript": "_incoming/trans/SRC-20260820-001.trans.txt",
        "page": "01_示例域/某个主题/2026-08-20_某个讲清楚的体系化教程.html",
